# Copy to .env and fill in. Never commit .env.

# SQLite for local development. For Postgres use e.g.
# postgresql+psycopg://user:password@localhost:5432/signal
DATABASE_URL=sqlite:///signal.db

# GitHub personal access token (classic or fine-grained, public read only).
# Unauthenticated requests are limited to 60/hour; a token raises it to 5,000/hour.
GITHUB_TOKEN=

# Contact string sent in the User-Agent header so API operators can reach you.
SIGNAL_USER_AGENT=signal-research (you@example.com)
